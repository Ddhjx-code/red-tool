<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <title>shot · 长页截图</title>
  <link rel="stylesheet" href="../assets/theme.css" />
  <link rel="stylesheet" href="../assets/ui.css" />
  <style>
    /* 只为出图：把纸面拉成一张长条，页脚按钮就不会被 A4 切掉。
       宽 420 让 --u ≈ 4.2px，接近 390 宽的手机比例。 */
    @page { size: 420px 2000px; margin: 0; }
    html, body { height: auto; overflow: visible; }
    #app { height: auto; }
    .stage, .home { overflow: visible; height: auto; }
  </style>
</head>
<body>
<div id="app">
  <section class="home" id="home"></section>
  <header class="top">
    <div class="top-row">
      <p class="kicker" id="kicker"></p>
      <span class="top-meta" id="meta"></span>
    </div>
    <h1 class="top-title" id="title"></h1>
    <div class="stepbar" id="stepbar"></div>
  </header>
  <main class="stage" id="stage"></main>
  <footer class="nav">
    <button class="nav-back" id="back" type="button">上一步</button>
    <div class="nav-spacer"></div>
    <span class="nav-count" id="count"></span>
    <button class="btn" id="next" type="button">下一步</button>
  </footer>
</div>

<script src="../data/series.js"></script>
<script src="../data/lesson-cdrive.js"></script>
<script src="../data/lesson-wechat.js"></script>
<script src="../data/lesson-phone.js"></script>
<script src="../data/lesson-boot.js"></script>
<script src="../assets/engine.js"></script>
</body>
</html>
